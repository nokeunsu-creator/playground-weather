# ---- 파이프라인(GitHub Actions secrets 또는 로컬 .env) ----
# 공공데이터포털(data.go.kr) 활용신청 후 발급되는 일반 인증키(Decoding 키)
DATA_GO_KR_KEY=
# 브이월드(vworld.kr) 인증키: 지오코딩 + 지도 타일
VWORLD_KEY=
# 카카오 디벨로퍼스 REST API 키(지오코딩 대안, 선택)
KAKAO_REST_KEY=
# 행안부 생활안전지도(safemap.go.kr) 오픈API 키(선택, 있으면 크롤링 대신 사용)
SAFEMAP_KEY=

# ---- 앱(vite, 빌드 시 포함됨) ----
# 정적 데이터가 올라간 주소. 비우면 /data (개발용 public/data)
VITE_DATA_BASE=
# 브이월드 지도 타일용 키(없으면 OSM 타일 - 개발 전용)
VITE_VWORLD_KEY=
# AdMob (없으면 구글 테스트 광고 ID 사용)
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
