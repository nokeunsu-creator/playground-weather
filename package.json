{
  "name": "playground-weather",
  "private": true,
  "version": "1.3.1",
  "description": "놀이터 날씨 - 아이 외출 판정 + 전국 놀이터·공원·화장실 지도 (공공데이터, 서버 없음)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync": "npm run build && npx cap sync android",
    "android": "npx cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "pipeline:places": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/build-places.ts",
    "pipeline:crawl": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/sources/cpf-crawl.ts",
    "pipeline:geocode": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/geocode.ts",
    "pipeline:weather": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/fetch-weather.ts",
    "pipeline:weather:mock": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/fetch-weather.ts --mock",
    "pipeline:tide": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs pipeline/fetch-tide.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
