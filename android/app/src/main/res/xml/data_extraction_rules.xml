<?xml version="1.0" encoding="utf-8"?>
<!-- 설정·즐겨찾기 등 로컬 데이터를 클라우드 백업·기기 이전 대상에서 제외(allowBackup=false 와 함께 Android 12+ 규칙) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
